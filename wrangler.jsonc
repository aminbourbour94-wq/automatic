{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "automatic",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0686d613-0f98-40ec-b40c-26d103b0613b","database_name": "zx" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b4303775330c42faa6244ab1263d7b31" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
